{
  "name": "@shidesheng0218/dsh-plugin-lint-panel",
  "version": "0.1.5",
  "description": "Shows how the DeepSeek Harness plugins installed in this profile fare across DSH versions, from the compatibility matrix.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "data/aggregate.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.2": "compatible"
      },
      "verifiedBy": "scripts/probe-boot.mjs, headless and web compositions, 2026-10-13"
    }
  }
}
